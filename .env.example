# ==============================================================================
# STUDENT CALENDAR WITH EVENTS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the variables for your environment.
# Do NOT commit your actual .env file to public repositories.

# Port for the Node.js Express API bridge server
PORT=3000

# Environment mode (development | production)
NODE_ENV=production

# Optional: Hostname binding (defaults to 0.0.0.0 for public access)
HOST=0.0.0.0
